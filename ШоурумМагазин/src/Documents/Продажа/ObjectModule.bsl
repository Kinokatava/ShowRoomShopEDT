Процедура ОбработкаПроведения(Отказ, Режим)
	// Данные о мастере и проценте комиссии по номенклатуре
	ДанныеНоменклатуры = ДанныеМастеровПоНоменклатуре();

	// регистр ОстаткиНоменклатуры Расход
	Движения.ОстаткиНоменклатуры.Записывать = Истина;
	Для Каждого ТекСтрокаТовары Из Товары Цикл
		Движение = Движения.ОстаткиНоменклатуры.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Номенклатура = ТекСтрокаТовары.Номенклатура;
		Движение.Количество = ТекСтрокаТовары.Количество;
	КонецЦикла;

	// регистры Продажи и РасчетыСМастерами
	Движения.Продажи.Записывать = Истина;
	Движения.РасчетыСМастерами.Записывать = Истина;
	Для Каждого ТекСтрокаТовары Из Товары Цикл
		ДанныеСтроки = ДанныеНоменклатуры.Получить(ТекСтрокаТовары.Номенклатура);
		Если ДанныеСтроки = Неопределено Тогда
			Мастер = Справочники.Контрагенты.ПустаяСсылка();
			ПроцентКомиссии = 0;
			ВидРеализации = Неопределено;
		Иначе
			Мастер = ДанныеСтроки.Мастер;
			ПроцентКомиссии = ДанныеСтроки.ПроцентКомиссии;
			ВидРеализации = ДанныеСтроки.ВидРеализации;
		КонецЕсли;

		Если ЗначениеЗаполнено(Мастер) Тогда
			Если ВидРеализации = Перечисления.ВидРеализацииМастера.Аренда Тогда
				// товар с арендованной полки — вся выручка мастеру
				СуммаМастеру = ТекСтрокаТовары.Сумма;
				ДоходМагазину = 0;
			Иначе
				// комиссионная реализация — магазин удерживает процент
				СуммаМастеру = ТекСтрокаТовары.Сумма * (100 - ПроцентКомиссии) / 100;
				ДоходМагазину = ТекСтрокаТовары.Сумма - СуммаМастеру;
			КонецЕсли;
		Иначе
			СуммаМастеру = 0;
			ДоходМагазину = 0;
		КонецЕсли;

		Движение = Движения.Продажи.Добавить();
		Движение.Период = Дата;
		Движение.Номенклатура = ТекСтрокаТовары.Номенклатура;
		Движение.Мастер = Мастер;
		Движение.Количество = ТекСтрокаТовары.Количество;
		Движение.СуммаПродажи = ТекСтрокаТовары.Сумма;
		Движение.СуммаМастеру = СуммаМастеру;
		Движение.ДоходМагазину = ДоходМагазину;

		Если ЗначениеЗаполнено(Мастер) И СуммаМастеру <> 0 Тогда
			Движение = Движения.РасчетыСМастерами.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
			Движение.Период = Дата;
			Движение.Мастер = Мастер;
			Движение.Сумма = СуммаМастеру;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ДанныеМастеровПоНоменклатуре()
	СписокНоменклатуры = Новый Массив;
	Для Каждого ТекСтрокаТовары Из Товары Цикл
		СписокНоменклатуры.Добавить(ТекСтрокаТовары.Номенклатура);
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Номенклатура,
	|	Номенклатура.Мастер КАК Мастер,
	|	Номенклатура.ПроцентКомиссии КАК ПроцентКомиссии
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка В (&СписокНоменклатуры)";
	Запрос.УстановитьПараметр("СписокНоменклатуры", СписокНоменклатуры);

	ДанныеНоменклатуры = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДанныеСтроки = Новый Структура("Мастер, ПроцентКомиссии");
		ДанныеСтроки.Мастер = Выборка.Мастер;
		ДанныеСтроки.ПроцентКомиссии = Выборка.ПроцентКомиссии;
		ДанныеНоменклатуры.Вставить(Выборка.Номенклатура, ДанныеСтроки);
	КонецЦикла;

	Возврат ДанныеНоменклатуры;
КонецФункции
